source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end

# Ruby 3.x no longer bundles webrick (needed by `jekyll serve`)
gem "webrick", "~> 1.8"

# Windows: timezone data
platforms :windows do
  gem "tzinfo-data"
end
